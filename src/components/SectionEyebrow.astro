---
interface Props {
  path: string;
  title: string;
  description?: string;
}

const { path, title, description } = Astro.props as Props;
---

<div class="mb-10">
  <p class="path-label">{path}</p>
  <h2 class="mt-3 font-display text-2xl font-semibold text-text sm:text-3xl">{title}</h2>
  {description && <p class="mt-2 max-w-2xl text-sm text-muted sm:text-base">{description}</p>}
</div>
