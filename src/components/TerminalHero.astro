---
import { site } from "../data/site";
---

<div class="win shadow-glow mx-auto w-full max-w-lg font-mono text-sm">
  <div class="win-bar">
    <span class="win-dot bg-[#f47272]"></span>
    <span class="win-dot bg-amber"></span>
    <span class="win-dot bg-cyan"></span>
    <span class="ml-2">visitor@portfolio - zsh</span>
  </div>

  <div class="space-y-1 p-5 leading-relaxed">
    <p>
      <span class="text-cyan">visitor</span><span class="text-muted">@</span><span class="text-violet">portfolio</span><span class="text-muted">:~$</span>
      <span id="hero-command" class="text-text"></span><span id="hero-cursor" class="cursor"></span>
    </p>

    <div id="hero-output" class="mt-2 space-y-1 text-muted opacity-0 transition-opacity duration-700">
      <p><span class="text-violet">name</span><span class="text-muted">:</span>     {site.name}</p>
      <p><span class="text-violet">role</span><span class="text-muted">:</span>     Full-Stack &amp; AI Developer</p>
      <p><span class="text-violet">based_in</span><span class="text-muted">:</span> {site.location}</p>
      <p><span class="text-violet">focus</span><span class="text-muted">:</span>    web apps · chatbots · GCP</p>
      <p>
        <span class="text-violet">status</span><span class="text-muted">:</span>
        <span class="text-cyan">●</span> open to new opportunities
      </p>
    </div>
  </div>
</div>

<script>
  const command = "whoami --verbose";
  const cmdEl = document.getElementById("hero-command");
  const outputEl = document.getElementById("hero-output");
  const cursorEl = document.getElementById("hero-cursor");

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (cmdEl && outputEl) {
    if (prefersReducedMotion) {
      cmdEl.textContent = command;
      outputEl.classList.remove("opacity-0");
    } else {
      let i = 0;
      const type = () => {
        if (i <= command.length) {
          cmdEl.textContent = command.slice(0, i);
          i++;
          setTimeout(type, 55);
        } else {
          setTimeout(() => {
            outputEl.classList.remove("opacity-0");
            cursorEl?.classList.add("hidden");
          }, 300);
        }
      };
      setTimeout(type, 500);
    }
  }
</script>
