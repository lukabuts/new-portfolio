---
import { site, nav } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface/60">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-10 md:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <p class="font-mono text-sm text-cyan">~/whoami</p>
        <p class="mt-3 max-w-sm text-sm text-muted">
          {site.name} - full-stack &amp; AI developer building web apps and
          conversational products from {site.location}.
        </p>
      </div>

      <div>
        <p class="font-mono text-sm text-cyan">~/sitemap</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-muted transition-colors hover:text-text">
                  {item.label.replace("~", "")}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="font-mono text-sm text-cyan">~/connect</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href={`mailto:${site.email}`} class="text-muted transition-colors hover:text-text">
              {site.email}
            </a>
          </li>
          <li>
            <a href={site.github} target="_blank" rel="noreferrer" class="text-muted transition-colors hover:text-text">
              github.com/lukabuts
            </a>
          </li>
          <li>
            <a href={site.linkedin} target="_blank" rel="noreferrer" class="text-muted transition-colors hover:text-text">
              linkedin.com/in/luka-butskhrikidze
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-border pt-6 font-mono text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>luka@portfolio:~$ echo "&copy; {year} {site.name}. All rights reserved."</p>
      <p>built with Astro &amp; Tailwind CSS</p>
    </div>
  </div>
</footer>
