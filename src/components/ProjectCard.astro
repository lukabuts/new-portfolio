---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props as Props;
---

<article class="win group flex h-full flex-col transition-colors hover:border-cyan/50">
  <div class="win-bar justify-between">
    <div class="flex items-center gap-2">
      <span class="win-dot bg-[#f47272]"></span>
      <span class="win-dot bg-amber"></span>
      <span class="win-dot bg-cyan"></span>
    </div>
    <span class="truncate">~/projects/{project.title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}</span>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex flex-wrap items-center gap-2">
      {project.categories.map((cat) => (
        <span class="tag border-cyan/30 text-cyan">{cat}</span>
      ))}
    </div>

    <h3 class="mt-3 font-display text-lg font-semibold text-text">{project.title}</h3>
    <p class="mt-1 font-mono text-xs text-muted">{project.role}</p>

    <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{project.description}</p>

    <div class="mt-4 flex flex-wrap gap-2">
      {project.skills.slice(0, 5).map((skill) => (
        <span class="tag">{skill}</span>
      ))}
      {project.skills.length > 5 && (
        <span class="tag">+{project.skills.length - 5}</span>
      )}
    </div>

    <div class="mt-5 flex items-center gap-4 font-mono text-sm">
      {project.liveDemoUrl && (
        <a
          href={project.liveDemoUrl}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-1.5 text-cyan transition-colors hover:text-text"
        >
          ./live <span aria-hidden="true">→</span>
        </a>
      )}
      {project.githubUrl && (
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-1.5 text-muted transition-colors hover:text-text"
        >
          ./source <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
  </div>
</article>
