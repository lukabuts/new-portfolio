---
import Layout from "../../layouts/Layout.astro";
import SectionEyebrow from "../../components/SectionEyebrow.astro";
import { experience } from "../../data/experience";
---

<Layout title="Experience" description="Work history and experience of Luka Butskhrikidze.">
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-20 sm:pt-24">
    <SectionEyebrow
      path="~/experience"
      title="Where I've worked"
      description="From shipping client frontends to building AI products and managing the infrastructure behind them."
    />

    <ol class="relative space-y-10 border-l border-border pl-8 sm:pl-10">
      {
        experience.map((job) => (
          <li class="relative">
            <span class="absolute left-[-2.55rem] top-1.5 flex h-5 w-5 items-center justify-center rounded-full border border-cyan bg-bg sm:left-[-3.05rem]">
              <span class="h-2 w-2 rounded-full bg-cyan" />
            </span>

            <div class="win p-6 sm:p-8">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-display text-xl font-semibold text-text">
                  {job.title} <span class="text-muted">@</span>{" "}
                  {job.link ? (
                    <a class="text-cyan hover:underline" href={job.link} target="_blank" rel="noopener noreferrer">
                      {job.company}
                    </a>
                  ) : (
                    <span class="text-cyan">{job.company}</span>
                  )}
                </h3>
                <span class="tag">{job.period}</span>
              </div>

              <p class="mt-3 text-sm leading-relaxed text-muted sm:text-base">{job.summary}</p>

              <ul class="mt-4 space-y-2">
                {job.highlights.map((point) => (
                  <li class="flex gap-2 text-sm leading-relaxed text-muted sm:text-base">
                    <span class="mt-1 text-cyan">▸</span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-5 flex flex-wrap gap-2">
                {job.stack.map((item) => <span class="tag border-magenta/30 text-magenta">{item}</span>)}
              </div>
            </div>
          </li>
        ))
      }

      <li class="relative">
        <span class="absolute left-[-2.55rem] top-1.5 flex h-5 w-5 items-center justify-center rounded-full border border-border bg-bg sm:left-[-3.05rem]">
          <span class="h-2 w-2 rounded-full bg-muted" />
        </span>
        <p class="font-mono text-sm text-muted">// earlier - self-taught, building personal projects to learn the stack.</p>
      </li>
    </ol>
  </section>
</Layout>
