---
import Layout from "../../layouts/Layout.astro";
import SectionEyebrow from "../../components/SectionEyebrow.astro";
import { site } from "../../data/site";
import resume from "../../../src/assets/luka_butskhrikidze_resume.pdf";
---

<Layout title="Contact" description="Get in touch with Luka Butskhrikidze.">
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-24 sm:pt-24">
    <SectionEyebrow
      path="~/contact"
      title="Let's build something"
      description="Open to full-stack projects, AI/chatbot work, or just a chat about either. Pick whatever's easiest for you."
    />

    <div class="grid gap-8 lg:grid-cols-[1fr_1.3fr]">
      <div class="win">
        <div class="win-bar">
          <span class="win-dot bg-[#f47272]"></span>
          <span class="win-dot bg-amber"></span>
          <span class="win-dot bg-cyan"></span>
          <span class="ml-2">contact.json</span>
        </div>
        <div class="space-y-4 p-5 font-mono text-sm">
          <div>
            <p class="text-violet">email</p>
            <a href={`mailto:${site.email}`} class="text-cyan transition-colors hover:text-text">{site.email}</a>
          </div>
          <div>
            <p class="text-violet">phone</p>
            <a href={`tel:${site.phone}`} class="text-text transition-colors hover:text-cyan">{site.phone}</a>
          </div>
          <div>
            <p class="text-violet">location</p>
            <p class="text-text">{site.location}</p>
          </div>
          <div>
            <p class="text-violet">github</p>
            <a href={site.github} target="_blank" rel="noreferrer" class="text-text transition-colors hover:text-cyan">github.com/lukabuts</a>
          </div>
          <div>
            <p class="text-violet">linkedin</p>
            <a href={site.linkedin} target="_blank" rel="noreferrer" class="text-text transition-colors hover:text-cyan">linkedin.com/in/luka-butskhrikidze</a>
          </div>
          <div>
            <p class="text-violet">resume</p>
            <div class="flex flex-wrap gap-3">
              <a href="./luka_butskhrikidze_resume.pdf" target="_blank" rel="noreferrer" class="text-text transition-colors hover:text-cyan">view_pdf()</a>
            </div>
          </div>
          <div class="border-t border-border pt-4 text-muted">
            <span class="text-cyan">●</span> usually replies within a day or two
          </div>
        </div>
      </div>

      <div class="win">
        <div class="win-bar">
          <span class="win-dot bg-[#f47272]"></span>
          <span class="win-dot bg-amber"></span>
          <span class="win-dot bg-cyan"></span>
          <span class="ml-2">new_message.sh</span>
        </div>
        <form id="contact-form" class="space-y-5 p-6 sm:p-8">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="font-mono text-xs text-cyan">--name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="mt-1.5 w-full rounded-md border border-border bg-surface-2 px-3 py-2.5 text-sm text-text outline-none transition-colors focus:border-cyan"
                placeholder="Your name"
              />
            </div>
            <div>
              <label for="email" class="font-mono text-xs text-cyan">--email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="mt-1.5 w-full rounded-md border border-border bg-surface-2 px-3 py-2.5 text-sm text-text outline-none transition-colors focus:border-cyan"
                placeholder="you@example.com"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="font-mono text-xs text-cyan">--subject</label>
            <input
              type="text"
              id="subject"
              name="subject"
              class="mt-1.5 w-full rounded-md border border-border bg-surface-2 px-3 py-2.5 text-sm text-text outline-none transition-colors focus:border-cyan"
              placeholder="What's this about?"
            />
          </div>

          <div>
            <label for="message" class="font-mono text-xs text-cyan">--message</label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              class="mt-1.5 w-full rounded-md border border-border bg-surface-2 px-3 py-2.5 text-sm text-text outline-none transition-colors focus:border-cyan"
              placeholder="Tell me a bit about your project..."
            ></textarea>
          </div>

          <button type="submit" class="btn-primary w-full justify-center sm:w-auto">
            send_message() <span aria-hidden="true">→</span>
          </button>
          <p class="font-mono text-xs text-muted">// opens your email client with this message pre-filled</p>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ email: site.email }}>
  const form = document.getElementById("contact-form");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = data.get("name");
    const senderEmail = data.get("email");
    const subject = data.get("subject") || `Portfolio inquiry from ${name}`;
    const message = data.get("message");

    const body = `${message}\n\n- ${name} (${senderEmail})`;
    const mailto = `mailto:${email}?subject=${encodeURIComponent(String(subject))}&body=${encodeURIComponent(body)}`;

    window.location.href = mailto;
  });
</script>
